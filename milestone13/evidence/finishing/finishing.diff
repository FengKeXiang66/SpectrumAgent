+def test_min_margin_records_smallest_limit_minus_difference():
+    labels = np.full((50, 200), -1, dtype=np.int32)
+    labels[:10] = 0  # 2000 pixels: limit 4, difference 0.
+    labels[20:] = 1  # 6000 pixels: limit 12, difference 0.
+    text, meta = generate(labels)
+    np.testing.assert_array_equal(restore(text, labels.shape), labels >= 0)
+    limit = max(2, int(np.ceil(.002 * 2000)))
+    assert meta["min_margin_px"] == limit == 4
+    assert generate(np.full((2, 3), -1, dtype=np.int32))[1]["min_margin_px"] == 0
+
+
+def test_confidence_histogram_preserves_high_and_low_in_sidecar(annotation_case):
+    c = annotation_case
+    configure_project(c.paths, c.project, {"PE": "PE_W0"})
+    document = {"regions": [{"source": "manual", "confidence": "high"},
+                            {"source": "manual", "confidence": "low"}]}
+    path, meta = write_projection(c.paths, c.identifier, c.project, c.header, 1,
+                                 np.zeros((3, 7), dtype=np.int32), {"0": "PE"}, document=document)
+    assert meta["confidence_counts"] == {"high": 1, "low": 1}
+    persisted = json.loads(Path(path).with_suffix(".meta.json").read_text("utf-8"))
+    assert persisted["confidence_counts"] == {"high": 1, "low": 1}
